# Xcode / SPM build artifacts
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
.DS_Store

# The .xcodeproj is generated by XcodeGen but committed on purpose: gen-demo.sh reads the existing
# DEVELOPMENT_TEAM back out of it on regenerate. Only the transient user state below is ignored.
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# SPM — the shared Package.resolved IS committed (an app pins its exact dependency versions for
# reproducible builds); only the per-user .swiftpm state is ignored.
.swiftpm/

# Pantrix dSYM-upload credentials (contains a CI key) — NEVER commit.
.pantrixrc
.pantrixrc*
